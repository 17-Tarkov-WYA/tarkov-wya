root = true

# 預設：UTF-8、LF、空白縮排 2 格
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# Markdown：行尾兩個空白代表換行，不自動刪除
[*.md]
trim_trailing_whitespace = false

# C#、XAML：Visual Studio 慣例（CRLF、縮排 4 格、UTF-8 BOM）
[*.{cs,xaml}]
charset = utf-8-bom
end_of_line = crlf
indent_size = 4

# C# 程式風格（詳見 docs/coding-style.md；建置時由 EnforceCodeStyleInBuild 檢查）
[*.cs]
# using 與命名空間
dotnet_sort_system_directives_first = true
csharp_using_directive_placement = outside_namespace:warning
csharp_style_namespace_declarations = file_scoped:warning

# 一律使用大括號、優先使用 var 於型別明確時
csharp_prefer_braces = true:warning
csharp_style_var_when_type_is_apparent = true:suggestion

# 換行：大括號獨立一行（Allman）
csharp_new_line_before_open_brace = all

# 命名規則
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private, private_protected
dotnet_naming_style.underscore_camel.capitalization = camel_case
dotnet_naming_style.underscore_camel.required_prefix = _
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel
dotnet_naming_rule.private_fields_underscore.severity = warning

dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_style.prefix_i.capitalization = pascal_case
dotnet_naming_style.prefix_i.required_prefix = I
dotnet_naming_rule.interfaces_prefix_i.symbols = interfaces
dotnet_naming_rule.interfaces_prefix_i.style = prefix_i
dotnet_naming_rule.interfaces_prefix_i.severity = warning

dotnet_naming_symbols.async_methods.applicable_kinds = method
dotnet_naming_symbols.async_methods.required_modifiers = async
dotnet_naming_style.async_suffix.capitalization = pascal_case
dotnet_naming_style.async_suffix.required_suffix = Async
dotnet_naming_rule.async_methods_suffix.symbols = async_methods
dotnet_naming_rule.async_methods_suffix.style = async_suffix
dotnet_naming_rule.async_methods_suffix.severity = warning

dotnet_naming_symbols.public_members.applicable_kinds = class, struct, enum, property, method, event, delegate, namespace
dotnet_naming_style.pascal.capitalization = pascal_case
dotnet_naming_rule.public_members_pascal.symbols = public_members
dotnet_naming_rule.public_members_pascal.style = pascal
dotnet_naming_rule.public_members_pascal.severity = warning

# 專案與方案檔
[*.{csproj,props,targets,sln,slnx,resx}]
end_of_line = crlf

# Windows 指令稿
[*.{bat,cmd,ps1}]
end_of_line = crlf

# 第三方原文，不檢查格式
[LICENSE]
charset = unset
end_of_line = unset
indent_style = unset
indent_size = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
